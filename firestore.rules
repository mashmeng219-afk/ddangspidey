rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWhitelistedOwner() {
      return isSignedIn() && (
        (request.auth.token.email == 'choehyejeong219@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Home Slider Cards
    match /homeCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(cardId);
    }

    // Hero Section Cards
    match /heroCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(cardId);
    }

    // Notices
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(noticeId);
    }

    // Talks (구상&잡담)
    match /talks/{talkId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(talkId);
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(videoId);
    }

    // Songs
    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(songId);
    }

    // Characters
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(characterId);
    }

    // Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isWhitelistedOwner() && isValidId(storyId);
    }

    // Anonymous Questions
    // 읽기: 모두 허용 (단, 답변 전 질문은 주인만)
    // 쓰기: 새 질문 생성만 누구나 가능 (50자 이내, 답변 필드는 비어 있어야 함)
    // 질문의 답변 작성/수정/삭제는 주인만
    match /questions/{questionId} {
      allow read: if isWhitelistedOwner() || (resource != null && resource.data.answered == true);
      allow create: if isValidId(questionId) &&
        request.resource.data.question is string &&
        request.resource.data.question.size() > 0 &&
        request.resource.data.question.size() <= 50 &&
        request.resource.data.answered == false &&
        (!('answer' in request.resource.data) || request.resource.data.answer == null || request.resource.data.answer == '');
      allow update, delete: if isWhitelistedOwner() && isValidId(questionId);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isWhitelistedOwner() && isValidId(adminId);
    }
  }
}
